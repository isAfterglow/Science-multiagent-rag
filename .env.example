# Enable only after `python -m app.cli benchmark-models` can reach Ollama.
MOOSE_COPILOT_LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Measured local selection: Coder 7B for constrained JSON; 3B is fallback.
LLM_PRIMARY_MODEL=qwen2.5-coder:7b
LLM_FAST_MODEL=qwen2.5:3b
LLM_NARRATIVE_MODEL=qwen2.5:7b

# Optional final fallback for malformed JSON / unavailable local inference.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Vector backend. Local is the reproducible small-corpus baseline. Milvus
# accepts a standalone server URI; Milvus Lite can use an absolute *.db path.
VECTOR_BACKEND=local
MOOSE_MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=scientific_chunks_v2
MILVUS_TOKEN=
MILVUS_INDEX_TYPE=FLAT
